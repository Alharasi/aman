---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSection from '../components/HomeSection.astro';
import AboutServicesSection from '../components/AboutServicesSection.astro';
import BottomControls from '../components/BottomControls.astro';
import { site } from '../data/site';

const activeLanguage = site.settings.languageMode === 'both'
  ? site.settings.defaultLanguage
  : site.settings.languageMode;

const title = site.meta.title[activeLanguage];
const description = site.meta.description[activeLanguage];
const keywords = site.meta.keywords[activeLanguage];
const author = site.profile.name[activeLanguage];
const sameAs = Object.values(site.contactLinks).filter((value) => /^https?:\/\//i.test(value));

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author,
  url: new URL('/', site.settings.siteUrl).toString(),
  image: new URL(site.profile.image, site.settings.siteUrl).toString(),
  description,
  sameAs
};
---

<BaseLayout
  title={title}
  titleAr={site.meta.title.ar}
  titleEn={site.meta.title.en}
  description={description}
  descriptionAr={site.meta.description.ar}
  descriptionEn={site.meta.description.en}
  keywords={keywords}
  author={author}
  siteUrl={site.settings.siteUrl}
  image={site.profile.image}
  languageMode={site.settings.languageMode}
  defaultLanguage={site.settings.defaultLanguage}
  structuredData={structuredData}
>
  <div class="viewport">
    <main class="track" id="track">
      <HomeSection site={site} activeLanguage={activeLanguage} />
      <AboutServicesSection site={site} activeLanguage={activeLanguage} />
    </main>
  </div>
  <BottomControls site={site} activeLanguage={activeLanguage} />
</BaseLayout>
