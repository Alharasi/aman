---
const { site, activeLanguage } = Astro.props;
---
<section class="slide" data-slide="about" aria-label={site.about.title[activeLanguage]}>
  <div class="content inner-content">
    <div class="page-symbol" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <circle cx="12" cy="8" r="3"></circle>
        <path d="M5 20c.7-4 3.1-6 7-6s6.3 2 7 6"></path>
      </svg>
    </div>
    <h2 data-ar={site.about.title.ar} data-en={site.about.title.en}>{site.about.title[activeLanguage]}</h2>
    <p class="subtitle" data-ar={site.about.description.ar} data-en={site.about.description.en}>
      {site.about.description[activeLanguage]}
    </p>
    <div class="divider" aria-hidden="true"><span></span></div>
    <div class="detail-list">
      {site.expertise.map((item) => (
        <div class="detail-row">
          <strong data-ar={item.title.ar} data-en={item.title.en}>{item.title[activeLanguage]}</strong>
          <span data-ar={item.description.ar} data-en={item.description.en}>{item.description[activeLanguage]}</span>
        </div>
      ))}
    </div>
  </div>
</section>
