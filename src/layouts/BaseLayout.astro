---
interface Props {
  title: string;
  titleAr: string;
  titleEn: string;
  description: string;
  descriptionAr: string;
  descriptionEn: string;
  keywords: readonly string[];
  author: string;
  siteUrl: string;
  image: string;
  languageMode: 'ar' | 'en' | 'both';
  defaultLanguage: 'ar' | 'en';
  structuredData: Record<string, unknown>;
}

const {
  title,
  titleAr,
  titleEn,
  description,
  descriptionAr,
  descriptionEn,
  keywords,
  author,
  siteUrl,
  image,
  languageMode,
  defaultLanguage,
  structuredData
} = Astro.props;

const activeLanguage = languageMode === 'both' ? defaultLanguage : languageMode;
const dir = activeLanguage === 'ar' ? 'rtl' : 'ltr';
const canonical = new URL('/', siteUrl).toString();
const socialImage = new URL(image, siteUrl).toString();
const ogLocale = activeLanguage === 'ar' ? 'ar_AR' : 'en_US';
const alternateLocale = activeLanguage === 'ar' ? 'en_US' : 'ar_AR';
---
<!doctype html>
<html lang={activeLanguage} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content={author} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="theme-color" content="#f6f2ea" />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} id="ogTitle" />
    <meta property="og:description" content={description} id="ogDescription" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={author} />
    <meta property="og:locale" content={ogLocale} />
    {languageMode === 'both' && <meta property="og:locale:alternate" content={alternateLocale} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} id="twitterTitle" />
    <meta name="twitter:description" content={description} id="twitterDescription" />
    <meta name="twitter:image" content={socialImage} />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/main.css" />
  </head>
  <body
    data-title-ar={titleAr}
    data-title-en={titleEn}
    data-description-ar={descriptionAr}
    data-description-en={descriptionEn}
    data-language-mode={languageMode}
    data-default-language={defaultLanguage}
  >
    <slot />
    <script is:inline src="/scripts/navigation.js" defer></script>
  </body>
</html>
